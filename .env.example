# Copy to .env for local dev. Never commit .env.
# In production (DigitalOcean), set these via the App Platform dashboard or .do/app.yaml.

# ── Django core ───────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-50-random-characters
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# ── Site ──────────────────────────────────────────────────────────────────────
SITE_URL=http://127.0.0.1:8000

# ── Database (optional in dev — defaults to SQLite if unset) ──────────────────
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# ── Telegram bot (required for auth flow) ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=bunurbekauth_bot

# ── Course pacing ─────────────────────────────────────────────────────────────
# 86400 = 24 hours between modules. Set to 0 to disable for testing.
MODULE_COOLDOWN_SECONDS=86400

# ── Cloudflare R2 media storage (production only) ─────────────────────────────
USE_R2=False
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=bunurbek-media
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# ── Email (production only) ───────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Bu Nurbek <noreply@bunurbek.uz>

# ── Security (production only) ────────────────────────────────────────────────
SECURE_SSL_REDIRECT=True
